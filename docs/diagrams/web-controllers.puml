class User <<Entity>>  <<Table>>  {
 {TableName=users}
--
	{field} +@Column("created_at") createdAt : LocalDateTime
	{field} +@Column("") email : String
	{field} +@Id id : Long
	{field} +@Column("is_deleted") isDeleted : Integer
	{field} +@Column("") name : String
	{field} +@Column("") password : String
}


class UserController {
	{field} -passwordEncoder : PasswordEncoder
	{method} +getAllUsers () : ResponseEntity
	{method} +getCurrentUser ( authentication : Authentication ) : ResponseEntity
	{method} +getMethodName ( param : String ) : String
	{method} +loginUser ( loginRequest : LoginRequest ) : ResponseEntity
	{method} +registerUser ( user : User ) : ResponseEntity
