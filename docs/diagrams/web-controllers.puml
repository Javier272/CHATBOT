class Task <<Entity>>  <<Table>>  {
 {TableName=tasks}
--
	{field} +@Column("") category : String
	{field} +@Column("created_at") createdAt : LocalDateTime
	{field} +@Column("") description : String
	{field} +@Column("due_date") dueDate : LocalDate
	{field} +@Column("hour_estimate") hoursEstimate : Integer
	{field} +@Id id : Long
	{field} +@Column("is_deleted") isDeleted : Integer
	{field} +priority : Integer
	{field} +@Column("real_hours") realHours : Integer
	{field} +@Column("sprint") sprint : Integer
	{field} +@Column("") status : String
	{field} +@Column("team_id") teamId : Long
	{field} +@Column("") title : String
	{field} +@Column("updated_at") updatedAt : LocalDateTime
	{field} +@Column("user_id") userId : Long
}


class TaskController {
	{method} +addTask ( task : Task ) : ResponseEntity
	{method} -convertToDTO ( task : Task ) : TaskResponse
	{method} +deleteTask ( id : Long ) : ResponseEntity
	{method} +getAllActiveTasks () : List
	{method} +getCompletedTasks () : List
	{method} +getPendingTasks () : List
	{method} +getTaskById ( id : Long ) : ResponseEntity
	{method} +updateTask ( task : Task , id : Long ) : ResponseEntity
}


interface TaskRepository {
	{method}  {abstract} +findByIdAndIsDeleted ( id : Long , isDeleted : Integer ) : Optional
	{method}  {abstract} +findByIsDeletedOrderByCreatedAtDesc ( isDeleted : Integer ) : List
	{method}  {abstract} +findByStatusAndIsDeletedOrderByCreatedAtDesc ( status : String , isDeleted : Integer ) : List
}


class TaskResponse {
	{field} -description : String
	{field} -dueDate : LocalDate
	{field} -hoursEstimate : Integer
	{field} -id : Long
	{field} -priority : Integer
	{field} -realHours : Integer
	{field} -sprint : Integer
	{field} -status : String
	{field} -title : String
	{field} -userName : String
	{method} +description () : String
	{method} +dueDate () : LocalDate
	{method} +equals ( paramObject1 : Object ) : boolean
	{method} +hashCode () : int
	{method} +hoursEstimate () : Integer
	{method} +id () : Long
	{method} +priority () : Integer
	{method} +realHours () : Integer
	{method} +sprint () : Integer
	{method} +status () : String
	{method} +title () : String
