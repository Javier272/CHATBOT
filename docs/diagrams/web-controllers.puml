	{method}  {abstract} +findByEmailAndIsDeleted ( email : String , isDeleted : Integer ) : Optional
}


class UserService {
	{method} +addUser ( newUser : User ) : User
	{method} +deleteUser ( id : int ) : boolean
	{method} +findAll () : List
	{method} +getUserById ( id : int ) : ResponseEntity
	{method} +test () : User
	{method} +updateUser ( id : int , user2update : User ) : User
}




AiController -->  AiService : aiService
AiController -->  TaskRepository : taskRepository
TaskController -->  TaskRepository : taskRepository
TaskController -->  TaskService : taskService
TaskController -->  UserRepository : userRepository
